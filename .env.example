# Copiá este archivo a .env.local y completá.
# Sin las variables de Supabase la tienda corre en MODO DEMO con los datos de src/lib/demo/catalog.ts.

# --- Fuente de datos: demo | backoffice (ver docs/CONEXION-BACKOFFICE.md, «Modo back office») ---
# Vacío o demo: como siempre (sin Supabase, datos de demostración; con Supabase, Supabase).
# backoffice: catálogo, precios, stock, categorías y configuración desde la API del back office de Albertito. Supabase no se usa.
DATA_SOURCE=
# Solo con DATA_SOURCE=backoffice. URL base de la API (en el servidor de producción, por la red interna de Docker).
BACKOFFICE_API_URL=
# Clave de la API de la tienda (cabecera X-Store-Key). SOLO SERVIDOR: nunca con prefijo NEXT_PUBLIC_.
STORE_API_KEY=
# Tiempo máximo de espera por pedido a la API, en ms (por defecto 4000)
BACKOFFICE_TIMEOUT_MS=
# WhatsApp del local para la página «Estamos actualizando la tienda» (cuando la API no responde). Solo dígitos, con código de país.
NEXT_PUBLIC_STORE_WHATSAPP=
# Solo para probar en tu compu contra la API local con fotos por http://localhost: permite esos hosts también en un build de producción.
# NUNCA en producción.
ALLOW_LOCAL_MEDIA=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = que Google no indexe (demos y pruebas)
SITE_NOINDEX=

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hosts extra para fotos (separados por coma). El Storage de Supabase ya está permitido.
# Con el back office: el host de sus fotos (ej. media.albertitocalzados.com.ar). Para la API local, «http://localhost:3002» (solo desarrollo).
IMAGE_HOSTS=

# Secreto compartido con el webhook de Supabase → /api/revalidate
REVALIDATE_SECRET=

# --- Panel /admin en MODO DEMO (solo sin Supabase). Con Supabase se usa Supabase Auth + rol admin ---
ADMIN_DEMO_EMAIL=admin@albertito.test
ADMIN_DEMO_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Back office (Fase 6): token para /api/admin/* ---
BACKOFFICE_API_TOKEN=

# --- Pagos: mock | payway (el mismo valor en las dos) ---
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYWAY_PUBLIC_KEY=
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_SITE_ID=
PAYWAY_ENV=sandbox
# Opcional: forzar la URL de la API de Payway
PAYWAY_API_URL=

# --- Envíos (Fase 4/6): mock | andreani,correo ---
SHIPPING_PROVIDERS=mock
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CONTRACT_DOMICILIO=
ANDREANI_CONTRACT_SUCURSAL=
CORREO_ARGENTINO_USER=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=

# --- Analítica (Fase 6) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Mails (confirmación de pedido). Sin esto, los mails se escriben en el log ---
RESEND_API_KEY=
EMAIL_FROM=Albertito Calzados <pedidos@albertitocalzados.com.ar>

# --- Instagram (cuenta profesional): últimos posts en el panel de Videos ---
INSTAGRAM_ACCESS_TOKEN=
