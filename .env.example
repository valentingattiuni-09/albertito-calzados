# Copiá este archivo a .env.local y completá.
# Sin las variables de Supabase la tienda corre en MODO DEMO con los datos de src/lib/demo/catalog.ts.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = que Google no indexe (demos y pruebas)
SITE_NOINDEX=

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hosts extra para fotos (separados por coma). El Storage de Supabase ya está permitido.
IMAGE_HOSTS=

# Secreto compartido con el webhook de Supabase → /api/revalidate
REVALIDATE_SECRET=

# --- Panel /admin en MODO DEMO (solo sin Supabase). Con Supabase se usa Supabase Auth + rol admin ---
ADMIN_DEMO_EMAIL=admin@albertito.test
ADMIN_DEMO_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Back office (Fase 6): token para /api/admin/* ---
BACKOFFICE_API_TOKEN=

# --- Pagos: mock | payway (el mismo valor en las dos) ---
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYWAY_PUBLIC_KEY=
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_SITE_ID=
PAYWAY_ENV=sandbox
# Opcional: forzar la URL de la API de Payway
PAYWAY_API_URL=

# --- Envíos (Fase 4/6): mock | andreani,correo ---
SHIPPING_PROVIDERS=mock
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CONTRACT_DOMICILIO=
ANDREANI_CONTRACT_SUCURSAL=
CORREO_ARGENTINO_USER=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=

# --- Analítica (Fase 6) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Mails (confirmación de pedido). Sin esto, los mails se escriben en el log ---
RESEND_API_KEY=
EMAIL_FROM=Albertito Calzados <pedidos@albertitocalzados.com.ar>

# --- Instagram (cuenta profesional): últimos posts en el panel de Videos ---
INSTAGRAM_ACCESS_TOKEN=
